#!/bin/bash

PORT="${TRIM_SERVICE_PORT:-23180}"
LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
APP_DIR="${TRIM_APPDEST}/server"
SERVER_PY="${APP_DIR}/server.py"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

find_python() {
    local c
    for c in /var/apps/python312/target/bin/python3 \
             /var/apps/python311/target/bin/python3 \
             /var/apps/python310/target/bin/python3 \
             /usr/bin/python3 /usr/local/bin/python3 /bin/python3; do
        if [ -x "${c}" ]; then
            echo "${c}"
            return 0
        fi
    done
    c=$(command -v python3 2>/dev/null)
    if [ -n "${c}" ] && [ -x "${c}" ]; then
        echo "${c}"
        return 0
    fi
    return 1
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

start_process() {
    if status; then
        return 0
    fi

    [ -d "${TRIM_PKGVAR}" ] || mkdir -p "${TRIM_PKGVAR}" 2>/dev/null

    if [ ! -f "${SERVER_PY}" ]; then
        log_msg "ERROR: server.py not found at ${SERVER_PY}"
        return 1
    fi

    PY=$(find_python)
    if [ -z "${PY}" ]; then
        log_msg "ERROR: no python3 interpreter found on this system"
        return 1
    fi

    log_msg "Starting ${PY} ${SERVER_PY} on port ${PORT}"
    export PORT
    export PYTHONIOENCODING=utf-8
    export PYTHONUNBUFFERED=1

    bash -c "exec \"${PY}\" -u \"${SERVER_PY}\"" >> "${LOG_FILE}" 2>&1 &
    printf "%s" "$!" > "${PID_FILE}"
    sleep 1

    if status; then
        log_msg "started, pid=${pid:-$!}"
        return 0
    fi
    log_msg "ERROR: process exited right after start, see log above"
    return 1
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return 0
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> "${LOG_FILE}" 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
        fi
        rm -f "${PID_FILE}"
        log_msg "process killed... "
    fi

    return 0
}

case $1 in
start)
    start_process
    exit $?
    ;;
stop)
    stop_process
    exit 0
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
